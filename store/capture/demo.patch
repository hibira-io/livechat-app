+// demoAI is a local recording stub: it answers with the first picked
+// knowledge entry, or hands off when none fits.
+func demoAI(ctx context.Context, r livechat.AIRequest) (livechat.AIAnswer, error) {
+	time.Sleep(1200 * time.Millisecond)
+	k := r.Knowledge
+	last := r.Turns[len(r.Turns)-1].Text
+	for _, w := range []string{"order", "注文", "訂單", "订单", "주문", "คำสั่งซื้อ", "đơn"} {
+		if strings.Contains(strings.ToLower(last), w) {
+			return livechat.AIAnswer{Handoff: true, Reason: os.Getenv("LIVECHAT_DEMO_REASON")}, nil
+		}
+	}
+	if k == "" {
+		return livechat.AIAnswer{Handoff: true, Reason: ""}, nil
+	}
+	if i := strings.Index(k, "\nA: "); i >= 0 {
+		k = k[i+4:]
+	} else if i := strings.Index(k, "\n"); i >= 0 {
+		k = k[i+1:]
+	}
+	if i := strings.Index(k, "\n\n"); i >= 0 {
+		k = k[:i]
+	}
+	return livechat.AIAnswer{Reply: strings.TrimSpace(k), Cost: 0.0004}, nil
+}
